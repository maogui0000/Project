# ═══════════════════════════════════════════════════════════
# 雲湧智生 — 智慧長照關懷系統 環境變數設定
# 複製此檔案並改名為 .env，依需求修改設定
# ═══════════════════════════════════════════════════════════

# ── Ollama AI 對話設定 ────────────────────────────────────
# Ollama 服務位址（預設 localhost:11434，通常不需改）
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 模型名稱
# 2GB RAM 推薦：qwen2:0.5b（最輕量）
# 4GB RAM 推薦：qwen2:1.5b 或 gemma2:2b
# 8GB+ RAM 推薦：gemma2 或 llama3:8b
OLLAMA_MODEL=gemma2

# ── 語音辨識 ASR 設定 ─────────────────────────────────────
# Taiwan-Tongues-ASR 本地模型路徑（預設使用專案內 models/ 目錄）
# 如模型存放在其他位置，請修改此路徑
# ASR_MODEL_PATH=C:/models/taiwan-tongues-asr

# Whisper 微調權重路徑（tts_module 訓練產出）
# WHISPER_WEIGHTS_PATH=./tts_module/taiwan_whisper.pt

# Whisper 模型大小（用於備援模式）：tiny / base / small / medium
# tiny：最快，準確度較低
# base：速度與準確度平衡（預設推薦）
# small：中文辨識最佳，但較慢且需更多 RAM
WHISPER_MODEL=base

# ── TTS 語音合成設定 ──────────────────────────────────────
# 引擎選擇：
#   edge    = Edge-TTS 多語合成（國/台/客，推薦，需網路）
#   pyttsx3 = 完全離線（適合無網路環境）
#   gtts    = Google TTS，音質較好，需要網路
TTS_ENGINE=edge

# ── 伺服器設定 ────────────────────────────────────────────
# FastAPI 後端
API_HOST=0.0.0.0
API_PORT=8001

# LINE Bot
LINE_BOT_PORT=5000
LINE_CHANNEL_SECRET=你的LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=你的LINE_CHANNEL_ACCESS_TOKEN
LINE_TARGET_USER_ID=你的LINE_USER_ID

# ── 天氣更新設定 ──────────────────────────────────────────
# 天氣資料更新間隔（秒），預設 21600 = 6 小時
WEATHER_UPDATE_INTERVAL=21600
